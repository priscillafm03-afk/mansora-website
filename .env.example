# Copy to .env.local for `vercel dev`; set the same keys in Vercel > Project > Settings > Environment Variables.
RESEND_API_KEY=
CONTACT_TO_EMAIL=priscilla@mansora-consulting.com
CONTACT_FROM_EMAIL="MANSORA Consulting <hello@mansora-consulting.com>"
TEAM_REMINDER_HOURS=24
FOLLOW_UP_DAYS=2
RESEND_AUDIENCE_ID=

# Lead log (Google Sheet via Apps Script, see integrations/google-sheet/Code.gs)
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# WhatsApp enquiry alerts via CallMeBot (https://www.callmebot.com/blog/free-api-whatsapp-messages/)
WHATSAPP_PHONE=
CALLMEBOT_API_KEY=

# Separate private Sales & Stock waiting list (Upstash Redis REST; never use app/newsletter storage)
WAITLIST_REDIS_REST_URL=
WAITLIST_REDIS_REST_TOKEN=
# Random secret, >=32 characters. Stable for existing email duplicate keys.
WAITLIST_HASH_SECRET=
# production for production; use a separate store and namespace for previews.
WAITLIST_NAMESPACE=
